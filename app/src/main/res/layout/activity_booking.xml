<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ĐẶT SÂN BÓNG"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/textThongTinSan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thông tin sân..."
                android:textColor="#555555"
                android:textSize="15sp"
                android:textStyle="italic"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editHoTen"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Họ tên người đặt"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editSoDienThoai"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Số điện thoại"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editNgayThue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Ngày thuê (VD: 25/11/2026)"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editGioBatDau"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Giờ bắt đầu (VD: 17:00)"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editSoGioThue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Số giờ thuê (VD: 2)"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/textTongTien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tổng tiền: 0 VNĐ"
                android:textColor="#D32F2F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/buttonXacNhanDat"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Xác Nhận Đặt Sân"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00796B"
                app:cornerRadius="25dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/buttonQuayLai"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Quay Lại"
                android:textColor="#00796B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#E0F2F1"
                app:cornerRadius="25dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>