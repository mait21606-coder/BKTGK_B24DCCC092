<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="THÊM SÂN BÓNG MỚI"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <EditText
                android:id="@+id/editMaSan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nhập mã sân (VD: S01)"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editTenSan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nhập tên sân"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editDiaChi"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nhập địa chỉ sân"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editGiaThue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Nhập giá thuê theo giờ"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/buttonLuuSan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Lưu Sân Bóng"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00796B"
                app:cornerRadius="25dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/buttonQuayLai"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Quay Lại"
                android:textColor="#00796B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#E0F2F1"
                app:cornerRadius="25dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>